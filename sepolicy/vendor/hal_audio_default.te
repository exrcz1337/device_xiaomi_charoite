allow hal_audio_default persist_data_file:dir search;
allow hal_audio_default sysfs_power_supply:file r_file_perms;
allow hal_audio_default sysfs_power_supply:dir search;
set_prop(hal_audio_default, vendor_mtk_audio_prop)

# Dolby
binder_call(hal_audio_default, hal_dms_default)
allow hal_audio_default hal_dms_hwservice:hwservice_manager find;

allow hal_audio_default hf_manager_device:chr_file rw_file_perms;
allow hal_audio_default audio_socket:sock_file rw_file_perms;
allow hal_audio_default sound_device:chr_file rw_file_perms;
